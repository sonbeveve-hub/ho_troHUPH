# Server
PORT=4000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-string
# Dùng để tạo link tra cứu trong email (không có dấu / ở cuối)
APP_URL=https://hotrohuph.site
# CC mặc định cho MỌI email hệ thống gửi ra (để trống nếu không cần)
NOTIFY_CC_EMAIL=

# SMTP (để trống nếu chưa có — hệ thống vẫn chạy bình thường, chỉ không gửi được email)
# Gmail:      SMTP_HOST=smtp.gmail.com     SMTP_PORT=465  SMTP_SECURE=true
# Hostinger:  SMTP_HOST=smtp.hostinger.com SMTP_PORT=465  SMTP_SECURE=true
# Outlook:    SMTP_HOST=smtp.office365.com SMTP_PORT=587  SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ho Tro <no-reply@example.com>"

# Gemini (AI gợi ý khắc phục sự cố qua chatbox) — để trống nếu chưa có, chatbox sẽ
# tự báo "chưa thể phân tích tự động" và không chặn việc gửi yêu cầu.
# Lấy API key miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Giai đoạn "Đã xử lý - Chờ xác nhận": số NGÀY LÀM VIỆC (bỏ qua Thứ 7/CN + ngày nghỉ lễ
# khai báo ở "/admin/holidays") trước khi nhắc nhở người gửi xác nhận, và trước khi tự động
# đóng nếu vẫn không phản hồi. Đây là giá trị MẶC ĐỊNH — có thể ghi đè riêng theo loại yêu
# cầu/mức ưu tiên tại "/admin/sla-rules".
CONFIRM_REMINDER_DAYS=2
CONFIRM_TIMEOUT_DAYS=5
CONFIRM_SWEEP_INTERVAL_MINUTES=60

# Nhắc người phụ trách (qua email) khi 1 yêu cầu vẫn "Đang xử lý" mà không có cập nhật gì
# sau ngần này ngày LÀM VIỆC (nhắc 1 lần duy nhất, không tự động đóng).
INPROGRESS_STALE_DAYS=3

# Phát hiện yêu cầu có thể trùng lặp theo NỘI DUNG mô tả (không giới hạn cùng email/loại yêu
# cầu): cửa sổ thời gian (ngày) tính từ lúc gửi, và ngưỡng độ tương đồng 0–1 (Dice coefficient
# trên trigram — cùng thuật toán PostgreSQL pg_trgm dùng, chạy bằng JS thuần).
DUPLICATE_WINDOW_DAYS=3
DUPLICATE_SIMILARITY_THRESHOLD=0.6

# Đề xuất FAQ bán tự động: số yêu cầu tối thiểu có giải pháp tương tự nhau để tạo 1 đề xuất
# chờ duyệt tại "/admin/faq-candidates", và chu kỳ quét (giờ).
FAQ_CANDIDATE_MIN_GROUP_SIZE=3
FAQ_CANDIDATE_SWEEP_INTERVAL_HOURS=24
