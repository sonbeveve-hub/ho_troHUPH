# Server
PORT=4000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-string

# SMTP (để trống nếu chưa có — hệ thống vẫn chạy bình thường, chỉ không gửi được email)
# Gmail:      SMTP_HOST=smtp.gmail.com     SMTP_PORT=465  SMTP_SECURE=true
# Hostinger:  SMTP_HOST=smtp.hostinger.com SMTP_PORT=465  SMTP_SECURE=true
# Outlook:    SMTP_HOST=smtp.office365.com SMTP_PORT=587  SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ho Tro <no-reply@example.com>"
