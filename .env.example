# Server
PORT=4000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-string
# Dùng để tạo link tra cứu trong email (không có dấu / ở cuối)
APP_URL=https://hotrohuph.site
# CC mặc định cho MỌI email hệ thống gửi ra (để trống nếu không cần)
NOTIFY_CC_EMAIL=

# SMTP (để trống nếu chưa có — hệ thống vẫn chạy bình thường, chỉ không gửi được email)
# Gmail:      SMTP_HOST=smtp.gmail.com     SMTP_PORT=465  SMTP_SECURE=true
# Hostinger:  SMTP_HOST=smtp.hostinger.com SMTP_PORT=465  SMTP_SECURE=true
# Outlook:    SMTP_HOST=smtp.office365.com SMTP_PORT=587  SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ho Tro <no-reply@example.com>"

# Gemini (AI gợi ý khắc phục sự cố qua chatbox) — để trống nếu chưa có, chatbox sẽ
# tự báo "chưa thể phân tích tự động" và không chặn việc gửi yêu cầu.
# Lấy API key miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Giai đoạn "Đã xử lý - Chờ xác nhận": số ngày trước khi nhắc nhở người gửi xác nhận,
# và tổng số ngày (cùng mốc resolved_at) trước khi tự động đóng nếu vẫn không phản hồi.
# Để trống để dùng mặc định (2 ngày nhắc nhở / 5 ngày tự đóng, kiểm tra mỗi 60 phút).
CONFIRM_REMINDER_DAYS=2
CONFIRM_TIMEOUT_DAYS=5
CONFIRM_SWEEP_INTERVAL_MINUTES=60

# Nhắc người phụ trách (qua email) khi 1 yêu cầu vẫn "Đang xử lý" mà không có cập nhật gì
# sau ngần này ngày (nhắc 1 lần duy nhất, không tự động đóng).
INPROGRESS_STALE_DAYS=3

# Cửa sổ thời gian (ngày) để cảnh báo yêu cầu có thể trùng lặp: cùng email người gửi + cùng
# loại yêu cầu, gửi trong khoảng thời gian này, và yêu cầu trước đó chưa đóng.
DUPLICATE_WINDOW_DAYS=3
